rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /advertising/{file} {
      allow read: if request.auth != null;
      allow create,update: if request.auth != null && request.auth.token.owner == true &&
        request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.metadata.owner == request.auth.uid &&
        request.resource.contentType.matches('image/(png|jpeg|webp)|video/mp4');
      allow delete: if request.auth != null && request.auth.token.owner == true;
    }
    match /{allPaths=**} { allow read,write: if false; }
  }
}
